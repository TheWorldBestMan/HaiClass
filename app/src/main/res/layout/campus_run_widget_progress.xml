<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/run_widget_summary"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginVertical="4dp"
    android:layout_weight="1.55"
    android:background="@drawable/widget_cell"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="6dp">

    <TextView
        android:id="@+id/run_widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/run_widget_title"
        android:textColor="@color/ocean_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/run_widget_track"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginVertical="3dp"
        android:importantForAccessibility="no"
        android:progressDrawable="@drawable/widget_run_progress_track" />

    <TextView
        android:id="@+id/run_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/blue_secondary"
        android:textSize="11sp" />
</LinearLayout>
